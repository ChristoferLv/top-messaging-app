generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageType {
  TEXT
  MIDIA
}

enum ChatType {
  NORMAL
  GROUP
}

model Users {
  id              Int             @id @default(autoincrement())
  username        String          @unique @db.VarChar(30)
  password        String
  note            String?         @db.VarChar(120)
  picture         String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  chatAsSender    Chats[]         @relation("ChatAsSender")
  chatAsRecipient Chats[]         @relation("ChatAsRecipient")
  messages        Messages[]
  contactOf       Contacts[]      @relation("contacOf")
  contactsOwner   Contacts[]      @relation("contactOwner")
  midias          Midias[]
  usersGroups     UsersGroups[]
  groupMessages   GroupMessages[]
  groupChats      GroupChats[]
  groupMidias     GroupMidias[]
}

model Contacts {
  contactOwner   Users @relation("contactOwner", fields: [contactOwnerId], references: [id], onDelete: Cascade)
  contactOwnerId Int
  contact        Users @relation("contacOf", fields: [contactId], references: [id], onDelete: Cascade)
  contactId      Int

  @@id([contactOwnerId, contactId])
}

model Chats {
  id          Int        @id @default(autoincrement())
  type        ChatType   @default(NORMAL)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  senderId    Int
  sender      Users      @relation(name: "ChatAsSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId Int
  recipient   Users      @relation(name: "ChatAsRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  messages    Messages[]

  @@unique([senderId, recipientId])
}

model Messages {
  id         Int         @id @default(autoincrement())
  type       MessageType
  content    String      @db.VarChar(1000)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  senderId   Int
  sender     Users       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chatsId    Int
  chat       Chats       @relation(fields: [chatsId], references: [id], onDelete: Cascade)
  midias     Midias?
}

model Midias {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  ownerId   Int
  owner     Users    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messageId Int      @unique
  message   Messages @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model GroupChats {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(40)
  description   String?         @db.VarChar(250)
  creatorId     Int
  creator       Users           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type          ChatType        @default(GROUP)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  usersGroups   UsersGroups[]
  groupMessages GroupMessages[]
  groupMidias   GroupMidias[]
}

model UsersGroups {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupChatId Int
  group       GroupChats @relation(fields: [groupChatId], references: [id], onDelete: Cascade)

  @@unique([userId, groupChatId])
}

model GroupMessages {
  id          Int          @id @default(autoincrement())
  type        MessageType
  content     String       @db.VarChar(1000)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  senderId    Int
  sender      Users        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  groupChatId Int
  chat        GroupChats   @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  groupMidias GroupMidias?
}

model GroupMidias {
  id             Int           @id @default(autoincrement())
  content        String        @db.Text
  ownerId        Int
  owner          Users         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  groupMessageId Int           @unique
  groupMessages  GroupMessages @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  groupId        Int
  group          GroupChats    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

