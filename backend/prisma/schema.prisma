generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageType {
  TEXT
  MIDIA
}

enum ChatType {
  NORMAL
  GROUP
}

model Users {
  id              Int             @id @default(autoincrement())
  username        String          @unique @db.VarChar(30)
  password        String
  note            String?
  picture         String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  chatAsSender    Chats[]         @relation("ChatAsSender")
  chatAsRecipient Chats[]         @relation("ChatAsRecipient")
  messages        Messages[]
  contactOf       Contacts[]      @relation("contacOf")
  contactsOwner   Contacts[]      @relation("contactOwner")
  midias          Midias[]
  usersGroups     UsersGroups[]
  groupMessages   GroupMessages[]
  groupChats      GroupChats[]
}

model Contacts {
  contactOwner   Users @relation("contactOwner", fields: [contactOwnerId], references: [id])
  contactOwnerId Int
  contact        Users @relation("contacOf", fields: [contactId], references: [id])
  contactId      Int

  @@id([contactOwnerId, contactId])
}

model Chats {
  id          Int        @id @default(autoincrement())
  type        ChatType   @default(NORMAL)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  senderId    Int
  sender      Users      @relation(name: "ChatAsSender", fields: [senderId], references: [id])
  recipientId Int
  recipient   Users      @relation(name: "ChatAsRecipient", fields: [recipientId], references: [id])
  messages    Messages[]

  @@unique([senderId, recipientId])
}

model Messages {
  id         Int         @id @default(autoincrement())
  type       MessageType
  content    String      @db.VarChar(1000)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  senderId   Int
  sender     Users       @relation(fields: [senderId], references: [id])
  chatsId    Int
  chat       Chats       @relation(fields: [chatsId], references: [id])
  midias     Midias[]
}

model Midias {
  id              Int            @id @default(autoincrement())
  content         String         @db.Text
  ownerId         Int
  owner           Users          @relation(fields: [ownerId], references: [id])
  messageId       Int?           @unique
  message         Messages?      @relation(fields: [messageId], references: [id])
  groupMessages   GroupMessages? @relation(fields: [groupMessagesId], references: [id])
  groupMessagesId Int?
}

model GroupChats {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(40)
  description   String?
  creatorId     Int
  creator       Users           @relation(fields: [creatorId], references: [id])
  type          ChatType        @default(GROUP)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  usersGroups   UsersGroups[]
  groupMessages GroupMessages[]
}

model UsersGroups {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        Users      @relation(fields: [userId], references: [id])
  groupChatId Int
  group       GroupChats @relation(fields: [groupChatId], references: [id])

  @@unique([userId, groupChatId])
}

model GroupMessages {
  id          Int         @id @default(autoincrement())
  type        MessageType
  content     String      @db.VarChar(1000)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  senderId    Int
  sender      Users       @relation(fields: [senderId], references: [id])
  groupChatId Int
  chat        GroupChats  @relation(fields: [groupChatId], references: [id])
  midias      Midias[]
}

