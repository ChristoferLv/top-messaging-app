generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id         Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(30) 
  password   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
